    <!-- Moving object: rotating bar (reuses wall_div size). Delete this block if unwanted. -->
    <model name="spinner">
      <pose>-3.3 -9.0 1 0 0 0</pose>
      <link name="bar">
        <inertial><mass>3</mass><inertia><ixx>1.010</ixx><iyy>2.960</iyy><izz>1.970</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><geometry><box><size>2.8 0.2 2</size></box></geometry></collision>
